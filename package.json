{
  "name": "creatorroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "models": "tsx src/model.ts --list",
    "agents:register": "tsx scripts/register-agents.ts",
    "switch:setup": "python3 scripts/setup-switch.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@fastify/multipart": "^9.2.0",
    "@fastify/static": "^10.1.10",
    "better-sqlite3": "^12.4.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.6"
  }
}
